---
import Callout from "@/components/Callout.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";

const connectorTools = [
  {
    name: "byoag_discover",
    purpose:
      "Validate public BYOAg metadata from an exact domain without connecting an account.",
    kind: "Read only",
  },
  {
    name: "byoag_begin_pairing",
    purpose:
      "Create a local pairing session and pairwise installation material.",
    kind: "Changes state",
  },
  {
    name: "byoag_complete_pairing",
    purpose: "Redeem protected pairing material or poll platform confirmation.",
    kind: "Changes state",
  },
  {
    name: "byoag_list_registrations",
    purpose: "Return public local registration metadata without credentials.",
    kind: "Read only",
  },
  {
    name: "byoag_list_engagements",
    purpose:
      "Fetch and validate signed engagements for one local registration.",
    kind: "Read only",
  },
  {
    name: "byoag_disconnect",
    purpose: "Revoke one registration and remove its local BYOAg state.",
    kind: "Destructive",
  },
];

const verificationSteps = [
  "Match the declared issuer and engagement role.",
  "Verify the manifest signature and content digest.",
  "Accept only supported declarative formats and versions.",
  "Resolve every required capability within the active grant.",
  "Keep the skill as an engagement-scoped overlay.",
  "Reject executable scripts, binaries, installers, hooks, and HTML.",
];
---

<DocsLayout
  pageId="tools-and-skills"
  title="MCP Tools and Skills"
  description="The implemented BYOAg connector tools and the proposed engagement-scoped tool and declarative skill model."
>
  <section class="bg-[#07111f] py-20">
    <div class="page-shell max-w-4xl">
      <p class="eyebrow">Interface and guidance</p>
      <h1 class="mt-4 text-5xl font-black leading-tight text-paper">
        Tools provide authority. Skills explain how to use it.
      </h1>
      <p class="mt-6 max-w-3xl text-xl leading-8 text-paper/74">
        BYOAg separates callable platform actions from declarative operating
        guidance. That distinction keeps permission enforcement out of prose and
        prevents a remote skill from becoming executable software.
      </p>
    </div>
  </section>

  <section class="bg-paper py-20 text-ink">
    <div class="page-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Implemented connector surface</p>
        <h2 class="mt-3 text-4xl font-black">
          Six tools manage the connection lifecycle
        </h2>
        <p class="mt-5 text-lg leading-8 text-ink/70">
          The plugin exposes one local MCP server. Its current tools discover
          platforms, pair accounts, inspect local registrations, retrieve signed
          engagements, and disconnect cleanly.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          connectorTools.map((tool) => (
            <article class="rounded-lg border border-ink/12 bg-white p-5">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h3 class="font-mono text-base font-bold text-ink">
                  {tool.name}
                </h3>
                <span class="rounded-full border border-ink/15 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-ink/55">
                  {tool.kind}
                </span>
              </div>
              <p class="mt-4 leading-7 text-ink/70">{tool.purpose}</p>
            </article>
          ))
        }
      </div>

      <Callout title="Public results, private credentials" tone="warm">
        The tools return local references and public metadata. Long-lived
        credentials and private keys stay inside the connector vault. A pairing
        code is accepted as an ordinary argument only in explicitly disclosed
        compatibility mode.
      </Callout>
    </div>
  </section>

  <section class="bg-[#0b1626] py-20">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Two MCP planes</p>
        <h2 class="mt-3 text-4xl font-black leading-tight text-paper">
          Connection tools are not experience tools
        </h2>
      </div>
      <div class="grid gap-4">
        <article
          class="rounded-lg border border-accent/40 bg-accent/[0.06] p-6"
        >
          <p class="eyebrow">Available now</p>
          <h3 class="mt-3 text-2xl font-bold text-paper">
            Local lifecycle connector
          </h3>
          <p class="mt-4 leading-7 text-paper/68">
            A stable, platform-neutral surface manages discovery, registration,
            engagement retrieval, and disconnect. It does not encode each
            platform’s business actions.
          </p>
        </article>
        <article class="rounded-lg border border-cyan/35 bg-cyan/[0.05] p-6">
          <p class="eyebrow">Proposed next layer</p>
          <h3 class="mt-3 text-2xl font-bold text-paper">
            Engagement-scoped platform tools
          </h3>
          <p class="mt-4 leading-7 text-paper/68">
            A future resolver exposes only the concrete tools mapped to
            authorized capabilities for one named engagement. Every invocation
            is still re-authorized by the platform.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-paper py-20 text-ink">
    <div class="page-shell grid gap-10 lg:grid-cols-2">
      <article>
        <p class="eyebrow">Tool invocation</p>
        <h2 class="mt-3 text-4xl font-black">Discovery is never approval</h2>
        <ol class="mt-7 grid gap-3" role="list">
          <li
            class="rounded-md border border-ink/12 bg-white p-4 leading-7 text-ink/72"
          >
            <strong class="text-ink">1.</strong> Select one engagement-scoped tool.
          </li>
          <li
            class="rounded-md border border-ink/12 bg-white p-4 leading-7 text-ink/72"
          >
            <strong class="text-ink">2.</strong> Attach the engagement credential
            outside model context.
          </li>
          <li
            class="rounded-md border border-ink/12 bg-white p-4 leading-7 text-ink/72"
          >
            <strong class="text-ink">3.</strong> Re-evaluate role, delegation, limits,
            and current policy server-side.
          </li>
          <li
            class="rounded-md border border-ink/12 bg-white p-4 leading-7 text-ink/72"
          >
            <strong class="text-ink">4.</strong> Require protected confirmation for
            consequential operations when policy says so.
          </li>
        </ol>
      </article>
      <article class="rounded-lg border border-ink/12 bg-[#fff8ed] p-6 sm:p-8">
        <p class="eyebrow">Structured result</p>
        <h2 class="mt-3 text-3xl font-black">Make decisions auditable</h2>
        <p class="mt-5 leading-7 text-ink/70">
          A completed action should return a structured result and an audit
          reference. Retries of consequential actions need an idempotency key so
          a network failure cannot silently duplicate an effect.
        </p>
        <p class="mt-4 leading-7 text-ink/70">
          Tool availability alone never proves that the present call is
          permitted.
        </p>
      </article>
    </div>
  </section>

  <section class="bg-[#07111f] py-20">
    <div class="page-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Declarative skill bundles</p>
        <h2 class="mt-3 text-4xl font-black text-paper">
          Scoped guidance, verified before activation
        </h2>
        <p class="mt-5 text-lg leading-8 text-paper/70">
          A platform may eventually publish signed instructions, references,
          examples, and schemas that teach an agent how to use an authorized
          tool surface. The content remains lower authority than system,
          developer, user, client-safety, and platform policy.
        </p>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          verificationSteps.map((step, index) => (
            <li class="rounded-lg border border-white/12 bg-white/[0.04] p-5 leading-7 text-paper/68">
              <span class="mb-3 block font-mono text-sm font-bold text-cyan">
                0{index + 1}
              </span>
              {step}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-paper py-20 text-ink">
    <div class="page-shell grid gap-10 lg:grid-cols-2">
      <article>
        <p class="eyebrow">Updates inside the envelope</p>
        <h2 class="mt-3 text-3xl font-black">
          Compatible guidance may refresh
        </h2>
        <p class="mt-5 leading-7 text-ink/70">
          A signed update that stays within the existing capabilities, data
          access, and effects may activate according to client policy.
        </p>
      </article>
      <article>
        <p class="eyebrow">Material expansion</p>
        <h2 class="mt-3 text-3xl font-black">
          New authority requires new consent
        </h2>
        <p class="mt-5 leading-7 text-ink/70">
          New tools, scopes, data access, side effects, or materially different
          behavior require renewed user approval. A signed bundle cannot widen
          the grant by itself.
        </p>
      </article>
    </div>
  </section>

  <section class="bg-[#0b1626] py-20">
    <div class="page-shell max-w-4xl">
      <Callout title="Current implementation boundary">
        The six lifecycle MCP tools and static bootstrap skill are implemented.
        Engagement-authorized remote tool discovery, dynamic tool filtering and
        routing, signed skill retrieval, digest verification, capability
        resolution, and scoped activation are not. The reference host advertises
        a remote MCP endpoint, but that endpoint is reserved for a future phase.
      </Callout>
      <a
        class="mt-8 inline-flex rounded-md border border-white/18 px-5 py-3 font-bold text-paper transition hover:border-cyan hover:bg-white/[0.06]"
        href="/protocol/teardown"
      >
        Continue to revocation and teardown
      </a>
    </div>
  </section>
</DocsLayout>
