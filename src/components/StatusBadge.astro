---
import type { PageStatus } from "@/config/navigation";

interface Props {
  status: PageStatus;
}

const { status } = Astro.props;
const labels: Record<PageStatus, string> = {
  implemented: "Implemented",
  draft: "Draft",
  experimental: "Experimental",
  conceptual: "Conceptual",
  planned: "Planned",
};
---

<span class:list={["status-badge", `status-badge-${status}`]}
  >{labels[status]}</span
>
