---
import { availableNavigationItems } from "@/config/navigation";

interface Props {
  pageId: string;
}

const { pageId } = Astro.props;
const index = availableNavigationItems.findIndex((item) => item.id === pageId);
const previous = index > 0 ? availableNavigationItems[index - 1] : undefined;
const next = index >= 0 ? availableNavigationItems[index + 1] : undefined;
---

{
  (previous || next) && (
    <nav
      class="docs-page-navigation page-shell"
      aria-label="Previous and next pages"
    >
      {previous ? (
        <a href={previous.href} rel="prev">
          <small>Previous</small>
          <span>← {previous.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={next.href} rel="next" class="docs-page-next">
          <small>Next</small>
          <span>{next.label} →</span>
        </a>
      )}
    </nav>
  )
}
