---
interface Props {
  title: string;
  tone?: "dark" | "warm";
}

const { title, tone = "dark" } = Astro.props;
---

<aside
  class:list={[
    "rounded-lg border p-6",
    tone === "warm"
      ? "border-ink/12 bg-[#fff8ed] text-ink"
      : "border-white/12 bg-white/[0.04] text-paper",
  ]}
>
  <h2 class="text-2xl font-bold leading-tight">{title}</h2>
  <div
    class:list={[
      "mt-4 leading-7",
      tone === "warm" ? "text-ink/74" : "text-paper/74",
    ]}
  >
    <slot />
  </div>
</aside>
