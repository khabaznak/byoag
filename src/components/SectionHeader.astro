---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="section-title mt-3 text-current">{title}</h2>
  {text && <p class="mt-5 text-lg leading-8 opacity-70">{text}</p>}
</div>
